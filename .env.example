GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_CLIPPER_INPUT_DIR=./data/input
AI_CLIPPER_OUTPUT_DIR=./data/output
AI_CLIPPER_TEMP_DIR=./data/temp

YOUTUBE_DATA_API_KEY=
# Optional OAuth credentials from your own Google Cloud project.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=http://localhost:8000/api/youtube/oauth/callback
# Optional exact channel ID for videos owned by the connected creator.
# Leave empty unless ownership of this channel is verified.
YOUTUBE_OWNED_CHANNEL_ID=

# Keep a 1 GiB floor and another 0.75 GiB for YouTube acquisition.
MIN_FREE_DISK_GB=1.0
ACQUISITION_WORKING_RESERVE_GB=0.75
# Browser uploads use a separate 0.5 GiB processing floor plus 128 MiB upload reserve.
# A 1,000,000,000-byte file needs about 1.56 GiB free before upload.
DIRECT_UPLOAD_MIN_FREE_GB=0.5
UPLOAD_WORKING_RESERVE_GB=0.125
EDITORIAL_MIN_SCORE=45
# Optional JSON overrides for positive editorial score weights, e.g. {"payoff_strength":2.5}
EDITORIAL_SCORE_WEIGHTS=
# Optional semantic camera effects require this confidence (0-1).
EFFECT_MIN_CONFIDENCE=0.78

# Auto Edit uses the existing analysis model unless a focused model is configured.
GEMINI_DEEP_MODEL=
GEMINI_METADATA_MODEL=
# Optional comma-separated fallback model IDs supported by your API project.
# GEMINI_FALLBACK_MODELS=gemini-3.8-flash
AUTO_EDIT_MAX_CANDIDATES=8
AUTO_EDIT_DEEP_CANDIDATES=5
